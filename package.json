{
  "name": "@infralayers/pumble-mcp",
  "version": "0.1.0",
  "description": "Universal MCP server for Pumble — autonomous message, thread, channel, and user management for any AI agent or LLM (Cursor, Cline, Claude, Windsurf, Antigravity, OpenHands).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pumble-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "InfraLayers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infralayers/pumble-mcp.git"
  },
  "homepage": "https://github.com/infralayers/pumble-mcp#readme",
  "bugs": {
    "url": "https://github.com/infralayers/pumble-mcp/issues"
  },
  "keywords": [
    "mcp",
    "pumble",
    "model-context-protocol",
    "ai-agents",
    "llm",
    "cursor",
    "cline",
    "claude",
    "windsurf",
    "antigravity",
    "chat"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
